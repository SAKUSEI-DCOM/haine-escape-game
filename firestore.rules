rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() {return request.auth != null;}
  match /rooms/{code} {
   allow create: if signed() && code.matches('[0-9]{4}') && request.resource.data.hostUid == request.auth.uid;
   allow read: if signed();
   // Prototype rules: host controls the room; participants may only perform a small set of actions.
   // Do not deploy for high-stakes or prize-bearing events without server-side validation.
   allow update: if signed() && (
     (resource.data.hostUid == request.auth.uid && request.resource.data.hostUid == resource.data.hostUid)
     ||
     (exists(/databases/$(database)/documents/rooms/$(code)/participants/$(request.auth.uid))
      && request.resource.data.hostUid == resource.data.hostUid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts','sabotage'])
      && request.resource.data.attempts >= resource.data.attempts
      && request.resource.data.attempts <= resource.data.attempts + 1
      && request.resource.data.attempts <= 100)
   );
   allow delete: if false;
   match /participants/{uid} {
     allow read: if signed();
     allow create,update: if signed() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['name','joinedAt','lastActionAt']);
     allow delete: if false;
   }
  }
 }
}
